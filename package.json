{
  "name": "@w5s/std-src",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:w5s/std.git"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean clean:root",
    "code-analysis": ":",
    "configure": "npm run mrm -- configure",
    "coverage": ":",
    "develop": ":",
    "docs": "node markdown.mjs && turbo run docs && pnpm --filter @w5s/website run start",
    "format": "turbo run format format:root --continue",
    "format:root": "eslint . --ignore-pattern='apps/*/**' --ignore-pattern='packages/*/**' --fix",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint . --ignore-pattern='apps/*/**' --ignore-pattern='packages/*/**'",
    "mrm": "npm exec --package=@w5s/mrm-preset@latest --package=mrm -- mrm --preset @w5s/mrm-preset",
    "prepare": "pnpm run \"/^prepare:.*/\"",
    "prepare:githooks": "[ -n \"${CI:-}\" ] || git config core.hooksPath .githooks",
    "prepare:packages": "turbo run prepare",
    "release": "[ -n \"${CI:-}\" ] && npx lerna publish --yes || npx lerna publish",
    "rescue": "git clean -fdx;pnpm install",
    "size-limit": "turbo run size-limit",
    "spellcheck": "turbo run spellcheck spellcheck:root",
    "spellcheck:root": "cspell --no-progress '**' --exclude='apps/*/**' --exclude='packages/*/**'",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:root",
    "validate": "turbo run build lint test typecheck size-limit"
  },
  "commitlint": {
    "extends": [
      "@w5s/commitlint-config"
    ],
    "rules": {}
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@lerna-lite/publish": "5.6.1",
    "@size-limit/preset-small-lib": "13.1.1",
    "@types/node": "20.19.43",
    "@w5s/commitlint-config": "3.28.0",
    "@w5s/conventional-changelog": "3.29.0",
    "@w5s/cspell-config": "3.28.0",
    "@w5s/eslint-config": "3.40.0",
    "@w5s/lefthook-config": "1.3.0",
    "@w5s/tsconfig": "3.1.40",
    "@w5s/tsdown-config": "1.14.0",
    "cspell": "10.3.3",
    "eslint": "10.10.0",
    "lefthook": "2.1.14",
    "markdown-magic": "4.11.0",
    "markdown-magic-package-json": "2.0.2",
    "markdown-magic-subpackage-list": "2.1.0",
    "size-limit": "13.1.1",
    "size-limit-preset-node-lib": "0.4.0",
    "tsdown": "0.23.0",
    "turbo": "2.10.13",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.0.0",
    "pnpm": ">=10.0.0"
  },
  "overrides": {
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
