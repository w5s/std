{
  "name": "@w5s/global-storage",
  "version": "1.0.0-alpha.0",
  "description": "Global storage",
  "keywords": [
    "fp",
    "functional",
    "global",
    "standard",
    "std"
  ],
  "homepage": "https://github.com/w5s/std/tree/master/packages/std#readme",
  "bugs": {
    "url": "https://github.com/w5s/std/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:w5s/std.git",
    "directory": "packages/global"
  },
  "license": "MIT",
  "author": "Julien Polo <julien.polo@gmail.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./internal/*": null
  },
  "files": [
    "dist/",
    "src/",
    "!**/*.spec.*",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "pnpm run \"/^build:.*/\"",
    "build:tsc": "pnpm exec tsdown",
    "clean": "pnpm run \"/^clean:.*/\"",
    "clean:tsc": "rm -rf dist",
    "docs": "node '../../markdown.mjs'",
    "format": "pnpm run \"/^format:.*/\"",
    "format:src": "pnpm exec eslint . --fix",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:src": "pnpm exec eslint .",
    "prepublishOnly": "npm run clean;npm run build",
    "size-limit": "pnpm exec size-limit",
    "spellcheck": "pnpm exec cspell --no-progress '**'",
    "test": "pnpm run \"/^test:.*/\"",
    "test:src": "pnpm exec vitest run",
    "tsc": "pnpm exec tsc",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.build.json",
    "validate": "npm run lint && npm run build && npm run test"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "5 kB"
    }
  ],
  "sideEffect": false
}
